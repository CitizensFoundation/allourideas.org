    "@types/express-useragent": "^1.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.16",
    "@types/passport": "^1.0.16",
    "@types/pg": "^8.10.2",
    "@types/request-ip": "^0.0.41",
    "@types/sequelize": "^4.28.9",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^9.0.7",
