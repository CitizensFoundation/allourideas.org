    "redis": "^4.6.7",
    "sequelize": "^6.32.1",
    "sequelize-cli": "^6.2.0",
    "socket.io": "^4.0.0",
    "temp": "^0.9.1",
    "ts-node": "^10.9.1",
    "typescript": "5.3.3",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "wordwrap": "^1.0.0",
    "ws": "^8.15.1",
    "yamljs": "^0.3.0"
  },
  "scripts": {
    "publish_live": "npm run build;npm pack && node repack && node publish.js https://registry.npmjs.org/",
    "publish_local": "npm run build;npm pack && node repack && node publish.js http://localhost:4873",
    "start": "nodemon -e ts ts-out/server_api/server.js",
    "watch-start": "tsc --project ./ --outDir ./ts-out -w & nodemon -q ./ts-out/server.js",
    "dev": "nodemon --config nodemon.json ./ts-out/server_api/server.js",
    "dev:debug": "nodemon --config nodemon.json --inspect-brk api_app.ts",
    "build": "tsc --project ./ --outDir ./ts-out && ncp ./node_modules/@yrpri/api/views ts-out/views && ncp config ts-out/config && mkdir -p ts-out/services && ncp ./node_modules/@yrpri/api/services/email_templates ts-out/services/email_templates && ncp ./node_modules/@yrpri/api/services/locales ts-out/services/locales"
  },
  "cacheDirectories": [
    "node_modules"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "ip-address@>=10.0.0 <10.7.4": "10.7.4",
    "undici@>=6.0.0 <6.29.1": "6.29.1",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "gaxios@6": {
      "uuid": "11.1.1"
    },
    "express-session": {
      "cookie": "0.7.2",
      "on-headers": "1.1.0"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "sequelize": {
      "uuid": "11.1.1"
    },
    "weaviate-ts-client": {
      "uuid": "11.1.1"
    },
    "@grpc/grpc-js@>=1.14.0 <1.14.6": "1.14.6",
    "@xmldom/xmldom@>=0.8.0 <0.8.15": "0.8.15",
    "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
    "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
    "firecrawl@>=4.0.0 <4.51.0": "4.51.0",
    "jshint": {
      "lodash": "4.18.1",
      "minimatch": "3.1.4"
    }
  }
}
